APP_NAME="EV Recharges"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8098

# Port web publie sur l'hote. HTTP_BIND=127.0.0.1 : local a la machine (a placer
# derriere un reverse proxy TLS) ; 0.0.0.0 : toutes les interfaces.
HTTP_BIND=127.0.0.1
HTTP_PORT=8098

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning

# La base tourne dans le conteneur "mariadb" du docker-compose :
# DB_HOST doit rester le nom du service, pas 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=ev
DB_USERNAME=ev
DB_PASSWORD=
# Utilise uniquement a la creation du conteneur MariaDB.
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# database et non file : le store fichier n'est pas atomique, deux requetes
# concurrentes se disputent le cache du rate limiter et levent des 500
# (fopen ... No such file or directory). Voir bootstrap/app.php.
CACHE_STORE=database
QUEUE_CONNECTION=sync

APP_TIMEZONE=Europe/Paris

# Planificateur : itineraire routier. La demo publique OSRM suffit ;
# basculer sur une instance privee si elle se met a refuser les appels.
OSRM_BASE_URL=https://router.project-osrm.org

# Planificateur : base nationale des bornes de recharge (data.gouv.fr).
# L'identifiant de ressource est stable, c'est son contenu qui change.
IRVE_CSV_URL=https://www.data.gouv.fr/api/1/datasets/r/eb76d20a-8501-400e-b336-d85724de5435

# Compte auquel la migration vers le multi-comptes rattache les donnees
# existantes. Sans effet une fois la migration passee.
EV_OWNER_EMAIL=admin@example.com

# Domaine dedie (optionnel) des liens de partage de position. Vide : servis
# sur le domaine principal.
POSITION_SHARE_DOMAIN=

# Bouton « Offrez-moi une bière » (lien PayPal.me). Vide : aucun bouton.
DONATE_URL=https://paypal.me/tevnouille

# Broker MQTT (service "mosquitto") : compte utilise par XPCarData pour publier
# et par le service mqtt-ingest pour lire. Voir INSTALL.md, section 9.
MQTT_USER=ev
MQTT_PASSWORD=
