APP_NAME="EV Recharges"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8096

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning

# La base tourne dans le conteneur "mariadb" du docker-compose :
# DB_HOST doit rester le nom du service, pas 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=ev
DB_USERNAME=ev
DB_PASSWORD=
# Utilise uniquement a la creation du conteneur MariaDB.
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
